# Optional: without GROQ_API_KEY the rules engine still matches lenders (template explanations, no chat/intake).
GROQ_API_KEY=
TAVILY_API_KEY=

# Leave PINECONE_API_KEY empty to use an in-memory KB (rebuilt from data/sample_kb + uploads on every start).
PINECONE_API_KEY=
PINECONE_INDEX_NAME=urban-money-lender-policies
PINECONE_NAMESPACE=lender-policies-v1

GROQ_MODEL=openai/gpt-oss-20b          # fast: grading, intake extraction, query rewrite
GROQ_MODEL_SMART=openai/gpt-oss-120b   # explanations, text-only recommendations, follow-up chat
LLM_PROVIDER=groq                      # groq or openai: who writes answers, rewrites questions, reads cases
OPENAI_MODEL=gpt-5-mini                # LLM_PROVIDER=openai: fast tasks
OPENAI_MODEL_SMART=gpt-5-mini          # LLM_PROVIDER=openai: answers (RAG_MODEL overrides)
OPENAI_REASONING_EFFORT=low            # minimal / low / medium / high
OPENAI_MAX_OUTPUT_TOKENS=8000          # answer plus hidden reasoning tokens
LLM_TIMEOUT_S=30
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

ADMIN_API_KEY=change-me-in-production
APP_ENV=development

POLICY_STALE_DAYS=90       # warn when a lender policy was verified longer ago than this
RATE_LIMIT_PER_MIN=12      # per client IP, on /api/recommend, /api/intake and /api/chat
WARMUP=true                # load embeddings + KB at startup instead of on the first search

# Urban Money knowledge base (primary source). Empty URBAN_MONEY_DIR = the "Urban Money" folder inside data/.
URBAN_MONEY_DIR=
KB_SYNC_ON_STARTUP=true    # index new / changed / deleted files when the app starts (Pinecone)
OCR_ENABLED=true           # OCR images and scanned PDF pages
KB_MAX_FILE_MB=200
KB_UPLOAD_MAX_MB=50         # largest file an admin can upload in the browser

# Grounded answers (RAG). Recorded with every answer; a change re-runs the golden tests (Admin > RAG quality).
RAG_MODEL=                 # empty = GROQ_MODEL_SMART, or OPENAI_MODEL_SMART when LLM_PROVIDER=openai
RAG_TEMPERATURE=0
RAG_MAX_TOKENS=1200
RAG_TOP_P=1
RAG_REASONING_EFFORT=      # low / medium / high for gpt-oss; empty = model default
RERANKER=cross-encoder/ms-marco-MiniLM-L-6-v2   # or "lexical" (no model download) or "none"
RAG_CANDIDATES=20          # candidates reranked per question
RAG_TOP_K=6                # passages sent to the model
RAG_MIN_RELEVANCE=0.2      # reranker score (0-1) a passage needs to count as evidence
VECTOR_TIMEOUT_S=8         # skip a vector search slower than this (keyword search still answers); 0 = no limit
RAG_QUERY_REWRITE=true     # LLM rewrite of conversational / follow-up questions
RAG_DEBUG_LOG=true         # keep a retrieval trace of every question for admins
RAG_TRACE_KEEP=3000
RAG_EVAL_AUTORUN=false     # run golden tests when the configuration or documents change
EVAL_JUDGE=true            # golden tests: a second model checks every claim against its cited passage
EVAL_JUDGE_PROVIDER=groq   # groq or openai: a different provider is a more independent judge, outside Groq's limits
OPENAI_API_KEY=            # needed for EVAL_JUDGE_PROVIDER=openai
EVAL_JUDGE_MODEL=          # empty = GROQ_MODEL_SMART (groq) or gpt-5 (openai)
EVAL_JUDGE_REASONING_EFFORT=high

# Sponsored cards under "Ask anything" answers (Admin > Ads). Never shown with lender recommendations.
ADS_ENABLED=true
ADS_EVERY_N_ANSWERS=3      # at most one ad per this many answers, per user
VISION_MODEL=qwen/qwen3.8-27b   # reads attached images; empty = OCR only

# User accounts (chat app). The first account registered, and any email listed here, becomes admin.
ADMIN_EMAILS=
ALLOW_REGISTRATION=true    # false = only admins can create accounts
SESSION_DAYS=7
AUTH_RATE_LIMIT_PER_MIN=10 # per client IP, on login and sign-up

# Usage and billing. Plans, model prices and warning thresholds are edited in Admin > Billing & usage.
PAYMENT_PROVIDER=mock      # razorpay, or mock (development only; refused when APP_ENV=production)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=   # Razorpay dashboard > Webhooks; point it at https://<host>/api/webhooks/payment
USAGE_RESERVATION_TTL_MIN=15

# Google Sign-In (optional): OAuth client id, type Web application. Empty = no Google button.
# Add the app's URL (and http://localhost:5173 for development) to its Authorized JavaScript origins.
GOOGLE_CLIENT_ID=
