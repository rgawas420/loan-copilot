# Production settings. Copy to .env on the server and fill in. Never commit the filled-in file.
DOMAIN=copilot.example.com           # DNS A record must point at this server (Caddy gets the HTTPS certificate)

APP_ENV=production
ADMIN_API_KEY=                       # long random string: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_EMAILS=you@example.com         # these accounts become admins when they sign up
ALLOW_REGISTRATION=false             # create users from the Admin console instead of open sign-up

# Models
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_MODEL_SMART=openai/gpt-oss-120b
LLM_PROVIDER=groq
OPENAI_MODEL=gpt-5-mini
OPENAI_MODEL_SMART=gpt-5-mini
OPENAI_REASONING_EFFORT=low
OPENAI_MAX_OUTPUT_TOKENS=8000
VISION_MODEL=qwen/qwen3.8-27b
TAVILY_API_KEY=

# Vector store: use Pinecone in production (the in-memory store re-embeds every document on each start).
PINECONE_API_KEY=
PINECONE_INDEX_NAME=urban-money-lender-policies
PINECONE_NAMESPACE=lender-policies-v1

# Knowledge base
KB_SYNC_ON_STARTUP=true
OCR_ENABLED=true
WARMUP=true

# Grounded answers (see README: RAG pipeline)
RAG_TEMPERATURE=0
RAG_DEBUG_LOG=true
RAG_EVAL_AUTORUN=false
EVAL_JUDGE=true
EVAL_JUDGE_PROVIDER=groq
OPENAI_API_KEY=
EVAL_JUDGE_MODEL=
EVAL_JUDGE_REASONING_EFFORT=high
RAG_TRACE_KEEP=20000                 # admin question log: ~80 KB each, so ~1.6 GB; about 2 days at 1,000 daily users

# Payments: "razorpay" for real money. Webhook URL to set in the Razorpay dashboard:
#   https://<DOMAIN>/api/webhooks/payment
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Ads
ADS_ENABLED=true
ADS_EVERY_N_ANSWERS=3

RATE_LIMIT_PER_MIN=12                # AI requests a minute per user (per IP when not logged in); plans can be stricter
AUTH_RATE_LIMIT_PER_MIN=10

# Concurrency (one process; most time is spent waiting on Groq / Pinecone, so threads are cheap)
THREADPOOL_SIZE=200                  # requests and answer streams handled at the same time
VECTOR_SEARCH_THREADS=32             # vector searches in flight, shared by all users

# Google Sign-In (optional): OAuth client id, type Web application. Empty = no Google button.
# Add the app's URL (and http://localhost:5173 for development) to its Authorized JavaScript origins.
GOOGLE_CLIENT_ID=
